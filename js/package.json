{
  "name": "skullet-tests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm typecheck && tsc -p tsconfig.json && pnpm build:pre",
    "build:pre": "esbuild src/pre.ts --bundle --format=iife --global-name=__skulletPre --minify --target=es2022 --outfile=../priv/static/skullet.pre.js",
    "typecheck": "tsc -p tsconfig.all.json",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "test": "pnpm build && node --test test/*.test.js",
    "verify": "pnpm build && git diff --exit-code -- ../priv/static"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "playwright": "^1.56.0",
    "typescript": "^7.0.2"
  }
}
