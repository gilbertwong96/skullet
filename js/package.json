{
  "name": "skullet-tests",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.all.json && pnpm build:pre",
    "test": "pnpm build && node --test test/",
    "verify": "pnpm build && git diff --exit-code -- ../priv/static",
    "build:pre": "esbuild src/pre.ts --bundle --format=iife --global-name=__skulletPre --minify --target=es2022 --outfile=../priv/static/skullet.pre.js"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "typescript": "^7.0.2",
    "esbuild": "^0.25.0"
  }
}
